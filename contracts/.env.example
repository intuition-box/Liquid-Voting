# Deployer key, funded with tTRUST on Intuition testnet (13579).
# Used by script/Deploy.s.sol. NEVER commit the real .env.
PRIVATE_KEY=

# Optional override for fork tests and scripts (defaults to the public RPC).
INTUITION_TESTNET_RPC=https://testnet.rpc.intuition.systems/http

# The curator: the one address whose stake makes a graph edge count, and the only key
# this project publishes on purpose — it ships inside the built bundle so a hosted
# visitor can create a domain that the delegations already cover, and it pays for their
# session. A throwaway testnet account holding a few tTRUST; never the key above, which
# deploys and funds everything. See ADR 0029.
#
# For a hosted build, pass the same value as a build-time variable named
# CURATOR_PRIVATE_KEY (a repository *variable*, not a secret).
CURATOR_PRIVATE_KEY=0x
