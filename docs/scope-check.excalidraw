      "width": 430,
      "height": 117.5
    },
    {
      "id": "el0048",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 380125,
      "version": 1,
      "versionNonce": 5026999,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756400000000,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 74.1,
      "y": 1139,
      "width": 401.8,
      "height": 97.5,
      "text": "Why stake, and not existence  (ADR 0004)\n\nMinting is permissionless: anyone can create\n`events \u2014 is a sub-domain of \u2014 treasury`\nfor a fraction of a cent. If existence were enough,\nwidening someone's delegation would cost that much.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why stake, and not existence  (ADR 0004)\n\nMinting is permissionless: anyone can create\n`events \u2014 is a sub-domain of \u2014 treasury`\nfor a fraction of a cent. If existence were enough,\nwidening someone's delegation would cost that much.",
      "autoResize": true,
      "lineHeight": 1.25
    },
