      "x": 60,
      "y": 1084,
      "width": 245.79999999999998,
      "height": 16.25,
      "text": "\u2460 NotATriple      \u2461 NotAttested",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2460 NotATriple      \u2461 NotAttested",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el0046",
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 364287,
      "version": 1,
      "versionNonce": 4817541,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756400000000,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 360,
      "y": 1084,
      "width": 628.0,
      "height": 16.25,
      "text": "The witness is never believed. It says where to look; every claim is recomputed.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The witness is never believed. It says where to look; every claim is recomputed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el0047",
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
