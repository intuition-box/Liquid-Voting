    {
      "id": "el0044",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 348449,
      "version": 1,
      "versionNonce": 4608083,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756400000000,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 46.69999999999999,
      "y": 964,
      "width": 916.6,
      "height": 81.25,
      "text": "for each consecutive pair:   tripleId = MultiVault.calculateTripleId(child, predicate, parent)\n\n\u2460  getVaultType(tripleId) == 1 ?          a positive triple \u2014 not an atom, not a counter-triple\n                                            (the vault REVERTS for a term never created \u2014 caught, becomes NotATriple)\n\u2461  getShares(attestor, tripleId) > 0 ?    the attestor holds a position on this edge",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for each consecutive pair:   tripleId = MultiVault.calculateTripleId(child, predicate, parent)\n\n\u2460  getVaultType(tripleId) == 1 ?          a positive triple \u2014 not an atom, not a counter-triple\n                                            (the vault REVERTS for a term never created \u2014 caught, becomes NotATriple)\n\u2461  getShares(attestor, tripleId) > 0 ?    the attestor holds a position on this edge",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el0045",
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
