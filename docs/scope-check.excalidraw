      "width": 1180.0,
      "height": 17.5,
      "text": "Discovery is client-side because the MultiVault has no reverse index; verification is on-chain because the witness is untrusted.  (ADR 0003)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Discovery is client-side because the MultiVault has no reverse index; verification is on-chain because the witness is untrusted.  (ADR 0003)",
      "autoResize": true,
      "lineHeight": 1.25
    },
