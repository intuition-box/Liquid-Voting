node_modules/
dist/
.env
# Every `.env*.local`: vite.config.ts generates `.env.development.local`, and the name
# may change again. The glob is what keeps the next one out.
.env*.local
.claude/
.agents/
CLAUDE.md
# Only the keys. `data/delegations.json` is signatures, hashes and addresses — no secret
# material — and the app refuses to render without it, so a clone that lacks it shows
# "Not set up yet" and the hosted site shows it to every visitor.
data/accounts.json
dist/
